# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/flex_finances

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Used both for the companion bot and to verify the
# initData hash coming from the Mini App WebView.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Public HTTPS URL where the Mini App is hosted (required by Telegram).
# e.g. https://finances.flexacademy.uz
WEB_APP_URL=https://your-app.example.com

# ─── Auth ────────────────────────────────────────────────────────────────────
# Max age (seconds) an initData payload is accepted for. Prevents replay.
INIT_DATA_MAX_AGE_SECONDS=86400

# Set to "1" to bypass Telegram initData verification during local development
# and authenticate as DEV_TELEGRAM_ID instead. NEVER enable in production.
DEV_AUTH_BYPASS=0
DEV_TELEGRAM_ID=

# ─── Web sessions (browser login, outside Telegram) ──────────────────────────
# Secret used to sign browser session tokens. Set a long random string in
# production; falls back to TELEGRAM_BOT_TOKEN if unset.
SESSION_SECRET=
# How long a browser stays logged in (days).
SESSION_TTL_DAYS=30

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Telegram user ID + name for the first CEO account created by `npm run seed`.
SEED_CEO_TELEGRAM_ID=
SEED_CEO_NAME=Flex Academy CEO
# Website login for the first CEO, so a browser-only deployment can bootstrap.
# Set BOTH to create a CEO who can sign in at the website with username/password.
SEED_CEO_USERNAME=
SEED_CEO_PASSWORD=

# ─── Business defaults ───────────────────────────────────────────────────────
# Days after the 1st of the month before an unpaid student becomes "overdue".
DEFAULT_GRACE_PERIOD_DAYS=5
# Default currency for stored monetary values.
DEFAULT_CURRENCY=UZS

# ─── Parent SMS (Eskiz.uz) ───────────────────────────────────────────────────
# Master switch. Leave at 0 until the Eskiz contract is signed and templates
# are approved. While 0, no SMS is sent and no SMS row is written.
SMS_ENABLED=0
# Log-only / dry run. While 1 (the default), messages are RECORDED in the
# sms_messages table with status "logged" but the Eskiz API is NEVER called —
# use this to review exactly what would go out before spending on real SMS.
# Set to 0 to actually deliver.
SMS_DRY_RUN=1
# Per-scenario toggles (both still gated by SMS_ENABLED).
SMS_RECEIPT_ENABLED=1
SMS_OVERDUE_ENABLED=1
# Academy name shown to parents in the message text.
SMS_ACADEMY_NAME=Flex Academy

# Eskiz gateway credentials (from your Eskiz.uz account) + endpoint.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Approved alphanumeric sender name, or the shared test sender "4546" in sandbox.
ESKIZ_SENDER=4546
